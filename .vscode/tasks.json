{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Build SDL3 Game",
      "command": "C:/mingw64/bin/gcc.exe",
      "args": [
        "-g",
        "main.c",
        "game_core.c",
        "-o",
        "game.exe",
        "-Iinclude",
        "-Llib",
        "-lmingw32",
        "-lSDL3"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}