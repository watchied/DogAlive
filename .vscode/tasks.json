{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Build SDL3 Game",
      "command": "C:/mingw64/bin/gcc.exe",
      "args": [
        "-g",
        "src/main.c",
        "src/core/game_core.c",
        "-o",
        "bin/game.exe",
        "-I.",
        "-Iinclude",
        "-Llib",
        "-lmingw32",
        "-lSDL3"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}